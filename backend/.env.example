# Database connection URL (PostgreSQL)
# For Supabase: DATABASE_URL should use port 6543 (pooler with ?pgbouncer=true), DIRECT_URL uses port 5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_life_os?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/student_life_os?schema=public"

# JWT configuration
JWT_SECRET="student-life-os-super-secure-secret-key-2026"
JWT_EXPIRES_IN="7d"

# Server configuration
PORT=3000

# Frontend origin for CORS
FRONTEND_URL="http://localhost:5173"
